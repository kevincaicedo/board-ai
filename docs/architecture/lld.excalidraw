   "fontSize": 17,
   "fontFamily": 5,
   "text": "Core::step runs only on the orchestrator task:\none owner, one order → deterministic.\nEvery channel and queue is bounded (LLD §5).\nInference never runs on the real-time thread\nor on the orchestrator task.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "re71",
   "originalText": "Core::step runs only on the orchestrator task:\none owner, one order → deterministic.\nEvery channel and queue is bounded (LLD §5).\nInference never runs on the real-time thread\nor on the orchestrator task.",
   "autoResize": true,
   "lineHeight": 1.25
  },
