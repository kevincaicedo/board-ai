   "fontSize": 16,
   "fontFamily": 5,
   "text": "Interruption if: cue word,\n≥ 4 words, ≥ 700 ms of voice,\npointer set in the last 1.5 s,\nor undecided after 900 ms.\nBackchannel if < 700 ms and\n“mm-hm · yeah · right · ok…”",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "re179",
   "originalText": "Interruption if: cue word,\n≥ 4 words, ≥ 700 ms of voice,\npointer set in the last 1.5 s,\nor undecided after 900 ms.\nBackchannel if < 700 ms and\n“mm-hm · yeah · right · ok…”",
   "autoResize": true,
   "lineHeight": 1.25
  },
