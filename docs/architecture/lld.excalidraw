   "link": null,
   "locked": false
  },
  {
   "id": "lkte136",
   "type": "text",
   "x": 1734,
   "y": 4244,
   "width": 780.64,
   "height": 148.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "hachure",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1895298604,
   "version": 1,
   "versionNonce": 1073896288,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760486400000,
   "link": null,
   "locked": false,
   "fontSize": 17,
   "fontFamily": 5,
   "text": "When a queue is full (LLD §5)\n• actors on tasks wait: the inbox, the bridge, speech-out reports, store requests\n• what can't wait is dropped and counted: UI commands, drops and drags, partials,\n  early finals, log lines, problems\n• latest wins on a watch: playback positions, Listening\n• the real-time thread never waits: the mic ring overwrites, the gain is an atomic\n• a refused Synthesize or StopVoice is answered by the orchestrator itself",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "lkre135",
   "originalText": "When a queue is full (LLD §5)\n• actors on tasks wait: the inbox, the bridge, speech-out reports, store requests\n• what can't wait is dropped and counted: UI commands, drops and drags, partials,\n  early finals, log lines, problems\n• latest wins on a watch: playback positions, Listening\n• the real-time thread never waits: the mic ring overwrites, the gain is an atomic\n• a refused Synthesize or StopVoice is answered by the orchestrator itself",
   "autoResize": true,
   "lineHeight": 1.25
  },
