   "link": null,
   "locked": false,
   "fontSize": 16,
   "fontFamily": 5,
   "text": "Interruption if: a cue word,\n≥ 4 words, ≥ 1,200 ms of voice,\na pointer set in the last 1.5 s,\na short remark, or undecided\nafter 1,200 ms. Backchannel:\nits final is “mm-hm · yeah · ok…”",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "re179",
   "originalText": "Interruption if: a cue word,\n≥ 4 words, ≥ 1,200 ms of voice,\na pointer set in the last 1.5 s,\na short remark, or undecided\nafter 1,200 ms. Backchannel:\nits final is “mm-hm · yeah · ok…”",
   "autoResize": true,
   "lineHeight": 1.25
  },
