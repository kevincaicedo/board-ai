   "fontSize": 17,
   "fontFamily": 3,
   "text": "~/BoardAI/            vault · source of truth\n  sessions/2026-10-14-request-path/\n    events.jsonl      append-only log\n    board.excalidraw  final board\n    digest.md         summary · proposals\n  notes/<slug>.md\n  projects/<name>.md  - [ ] task ^t27\n  projects/<id>/sources.md   kept sources\n  projects/<id>/briefs/<src>-<hash>--<topic>.md\n  memory/about-you.md\n  memory/facts.md",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "re185",
   "originalText": "~/BoardAI/            vault · source of truth\n  sessions/2026-10-14-request-path/\n    events.jsonl      append-only log\n    board.excalidraw  final board\n    digest.md         summary · proposals\n  notes/<slug>.md\n  projects/<name>.md  - [ ] task ^t27\n  projects/<id>/sources.md   kept sources\n  projects/<id>/briefs/<src>-<hash>--<topic>.md\n  memory/about-you.md\n  memory/facts.md",
