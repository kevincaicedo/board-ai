   "fontSize": 17,
   "fontFamily": 3,
   "text": "Memory policy (core::memory, one match on MemoryKind)\nKeep       session record · learning signals · what you state about you or your systems\nPropose    anything inferred → digest → kept after your yes\nOnRequest  notes · tasks\nNever      raw voice audio · secrets (redacted at the store boundary, I8)",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "re191",
   "originalText": "Memory policy (core::memory, one match on MemoryKind)\nKeep       session record · learning signals · what you state about you or your systems\nPropose    anything inferred → digest → kept after your yes\nOnRequest  notes · tasks\nNever      raw voice audio · secrets (redacted at the store boundary, I8)",
   "autoResize": true,
   "lineHeight": 1.25
  },
