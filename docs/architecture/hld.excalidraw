   "link": null,
   "locked": false
  },
  {
   "id": "te112",
   "type": "text",
   "x": 1574,
   "y": 1664,
   "width": 383.04,
   "height": 202.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "hachure",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 407593829,
   "version": 2,
   "versionNonce": 340323999,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1760486400000,
   "link": null,
   "locked": false,
   "fontSize": 18,
   "fontFamily": 5,
   "text": "Later · hosted\nSame core + runtime on a server.\nUI in the browser over WebSocket;\naudio over WebRTC.\nManaged models + sync by subscription.\n\nWhy it stays cheap: the UI only talks\nthrough the protocol, and core +\nruntime never import Tauri.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "re111",
   "originalText": "Later · hosted\nSame core + runtime on a server.\nUI in the browser over WebSocket;\naudio over WebRTC.\nManaged models + sync by subscription.\n\nWhy it stays cheap: the UI only talks\nthrough the protocol, and core +\nruntime never import Tauri.",
   "autoResize": true,
   "lineHeight": 1.25
  },
